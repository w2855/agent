{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Desktop — dsh-go 的桌面客户端（复刻原 UI，本地零运行时依赖）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win portable"
  },
  "keywords": [
    "dsh",
    "desktop",
    "electron"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "cn.dsh.desktop",
    "productName": "DSH Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "runtime/**",
      "lib/**",
      "renderer/**",
      "assets/**",
      "package.json",
      "!assets/pet/**"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "DSH-Desktop-${version}.exe"
    },
    "electronVersion": "45.3.1"
  }
}
